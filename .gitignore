# Nothing here needs to be ignored today — the project deliberately ships
# without a node_modules folder (pi injects its own modules at runtime).
# Kept for completeness in case local tooling adds temporary artifacts.
node_modules/
*.staged.ts
*.log

# Maintainer-local type check config: same as tsconfig.json but with this
# machine's pi install path filled in. Never commit it - it is not portable.
tsconfig.local.json

# Files the dev tests stage next to themselves while they run
dev/*.ts
